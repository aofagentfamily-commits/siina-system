# ---- SIINA SYSTEM environment (copy to .env and fill in) ----
# Required: at least 32 random characters. Protects OTP hashes, webhook secrets and encrypts Telegram bot tokens.
# Changing this value makes saved Telegram bot tokens unreadable: re-enter them afterwards.
APP_SECRET=replace-with-64-random-characters-generated-by-openssl-rand-hex-32

# Who may sign in with an email OTP (comma separated, lowercase).
ALLOWED_EMAILS=you@example.com

# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=production
# Public HTTPS address of this app. Needed only for Telegram webhook mode.
PUBLIC_URL=
# Set to 1 when served over HTTPS (adds the Secure flag to the session cookie).
COOKIE_SECURE=1

# Outgoing email (OTP codes are sent here; required for sign-in)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="SIINA SYSTEM <no-reply@example.com>"

# Optional: where SQLite data lives (default ./data)
# DATA_DIR=/var/lib/siina-system
